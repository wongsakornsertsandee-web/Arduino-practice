int data = 1; // Declare an integer variable 'data' and initialize it to 10


void setup () {
  Serial.begin(9600); // Initialize serial communication at 9600 baud rate
  
  Serial.println("Hello, World!"); // Print a message to the serial monitor

  //for (int i = 0; i < 10; i++) { // For loop that iterates 10 times
  //  Serial.print("i: "); // Print the current iteration number 
  //  Serial.println(i); // Print the value of 'i'
  //}

  while (data < 10) { // While loop that continues as long as 'data' is less than 10
    Serial.print("data: "); // Print the current value of 'data'
    Serial.println(data); // Print the value of 'data'
    data++; // Increment 'data' by 1
  }
}

